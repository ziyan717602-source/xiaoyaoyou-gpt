{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ziyan717602-source/xiaoyaoyou-gpt/oracle/golden-traces/trace.schema.json",
  "title": "Legacy normalized golden trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "evidenceGrade",
    "derivation",
    "sourceSnapshotSha256",
    "nondeterminism",
    "sources",
    "contentIds",
    "initialState",
    "steps",
    "expectedFinalState"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^legacy-(basic-turn|bingxin-response|dying-rescue)$"
    },
    "title": { "type": "string", "minLength": 1 },
    "evidenceGrade": { "enum": ["A", "B", "C", "D"] },
    "derivation": { "const": "source-derived-normalized" },
    "sourceSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nondeterminism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legacy", "normalization"],
      "properties": {
        "legacy": { "type": "string", "minLength": 1 },
        "normalization": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "lineStart", "lineEnd", "sha256", "claim"],
        "properties": {
          "path": { "type": "string", "pattern": "^reference/psd48-master/" },
          "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "claim": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contentIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^xyy\\." }
    },
    "initialState": { "$ref": "#/$defs/state" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "expectedFinalState": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "team", "hp", "alive", "hand"],
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 6 },
        "team": { "type": "integer", "minimum": 1, "maximum": 2 },
        "hp": { "type": "integer", "minimum": 0 },
        "alive": { "type": "boolean" },
        "hand": { "type": "integer", "minimum": 0 }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "status", "targetEffectId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "source": { "type": "integer", "minimum": 1, "maximum": 6 },
        "status": { "enum": ["pending", "resolved", "cancelled"] },
        "targetEffectId": { "type": ["string", "null"] }
      }
    },
    "window": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "subject", "eligible", "passed"],
          "properties": {
            "kind": { "enum": ["response", "rescue"] },
            "subject": { "type": "string", "minLength": 1 },
            "eligible": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 6 }
            },
            "passed": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 6 }
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "rounder",
        "players",
        "effects",
        "window",
        "pendingDying",
        "winner"
      ],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "rounder": { "type": "integer", "minimum": 1, "maximum": 6 },
        "players": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/player" }
        },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "window": { "$ref": "#/$defs/window" },
        "pendingDying": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 6 }
        },
        "winner": { "type": ["integer", "null"], "minimum": 0, "maximum": 2 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation", "params", "evidence", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "operation": {
          "enum": [
            "set-phase",
            "draw",
            "advance-rounder",
            "play-effect",
            "open-response",
            "pass-response",
            "play-counter",
            "cancel-effect",
            "resolve-effect",
            "damage",
            "detect-dying",
            "open-rescue",
            "pass-rescue",
            "rescue",
            "close-rescue",
            "check-winner"
          ]
        },
        "params": { "type": "object" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
