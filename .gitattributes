* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf

# Keep the legacy reference byte-for-byte unchanged. More specific LFS rules
# below still replace binary content with pointers in normal Git history.
reference/** -text

# Preserve the legacy binary reference without bloating normal Git history.
reference/**/*.png filter=lfs diff=lfs merge=lfs -text
reference/**/*.jpg filter=lfs diff=lfs merge=lfs -text
reference/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
reference/**/*.ogg filter=lfs diff=lfs merge=lfs -text
reference/**/*.wav filter=lfs diff=lfs merge=lfs -text
reference/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
reference/**/*.ico filter=lfs diff=lfs merge=lfs -text
reference/**/*.dll filter=lfs diff=lfs merge=lfs -text
reference/**/*.db3 filter=lfs diff=lfs merge=lfs -text
reference/**/*.doc filter=lfs diff=lfs merge=lfs -text
reference/**/*.docx filter=lfs diff=lfs merge=lfs -text
