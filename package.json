{
  "name": "xiaoyaoyou-gpt",
  "version": "0.0.0",
  "private": true,
  "description": "逍遥游多人浏览器版迁移工程",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "tsc -b && npm run build -w @xiaoyaoyou/web",
    "dev:server": "npm run dev -w @xiaoyaoyou/server",
    "dev:web": "npm run dev -w @xiaoyaoyou/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  }
}
