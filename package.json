{
  "name": "xiaoyaoyou-gpt",
  "version": "0.0.0",
  "private": true,
  "description": "逍遥游多人浏览器版迁移工程",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "build": "tsc -b && npm run build -w @xiaoyaoyou/web",
    "check:fast": "npm run format:check && npm run typecheck && npm run check:public-history && npm run test:unit",
    "check:full": "npm run check:fast && npm run build && npm run test:replay && npm run test:bots && npm run test:e2e",
    "check:public-history": "node scripts/check-public-history.mjs",
    "dev:server": "npm run dev -w @xiaoyaoyou/server",
    "dev:web": "npm run dev -w @xiaoyaoyou/web",
    "goal:preflight": "node scripts/goal-preflight.mjs",
    "oracle:build": "node scripts/legacy/build-oracle.mjs",
    "oracle:inventory": "node --disable-warning=ExperimentalWarning scripts/legacy/inventory.mjs --verify",
    "oracle:refresh-inventory": "node --disable-warning=ExperimentalWarning scripts/legacy/inventory.mjs --write",
    "test": "vitest run",
    "test:unit": "vitest run packages --exclude **/*.replay.test.ts --exclude **/*.bot.test.ts",
    "test:replay": "vitest run --config vitest.replay.config.ts",
    "test:bots": "vitest run --config vitest.bots.config.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  }
}
